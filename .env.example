# Copy to .env and fill in. NEVER commit .env.

# --- Service ---
APP_ENV=dev                 # dev | staging | production   (production forces auth + hides /docs)
LOG_LEVEL=INFO
LOG_FORMAT=text             # text for local dev, json for servers (Loki/ELK/CloudWatch)
LOG_DIR=logs                # readable request blocks: logs/app.log + logs/requests/<day>/<request_id>.log
LOG_REQUEST_FILES=true      # one log file per API call
LOG_REQUEST_PAYLOADS=true   # include user message, thinking, tool args/results, answer in the blocks (contains PII)
LOG_RETENTION_DAYS=14

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=http://173.234.75.166:8003/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=dd
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Security ---
# "caller:key" pairs, comma separated. Generate keys with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=
RATE_LIMIT_PER_MINUTE=30            # per caller
MAX_CONCURRENT_PER_CALLER=3         # requests one caller can run at once (0 = unlimited)
DAILY_TOKEN_BUDGET_PER_CALLER=0     # LLM tokens per caller per day (0 = unlimited), e.g. 500000
MAX_CONCURRENT_RUNS=20              # whole service - protects the LLM server (0 = unlimited)
MAX_INPUT_CHARS=8000
CORS_ORIGINS=

# --- Sessions ---
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=10000

# --- Monitoring ---
METRICS_ENABLED=true

# --- Agent-specific secrets (referenced as ${VAR} in agent/agent.yaml) ---
# COPILOT_MCP_URL=
# COPILOT_MCP_TOKEN=
# ZOHO_MCP_URL=
